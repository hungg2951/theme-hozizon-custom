

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>

    {% if show_arrows %}
      <button
        type="button"
        class="announcement-bar__control announcement-bar__control--previous"
        aria-label="{{ 'accessibility.slideshow_previous' | t }}"
        on:click="/previous"
        onpointerup="this.blur()"
        ref="previous"
      >
        <svg role="presentation" focusable="false" width="7" height="10" class="icon icon-chevron-left reverse-icon" viewBox="0 0 7 10">
          <path d="M6 1 2 5l4 4" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </button>

      <button
        type="button"
        class="announcement-bar__control announcement-bar__control--next"
        aria-label="{{ 'accessibility.slideshow_next' | t }}"
        on:click="/next"
        onpointerup="this.blur()"
        ref="next"
      >
        <svg role="presentation" focusable="false" width="7" height="10" class="icon icon-chevron-right reverse-icon" viewBox="0 0 7 10">
          <path d="m1 9 4-4-4-4" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </button>
    {% endif %}
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    background-color: #000000 !important;
    color: #ffffff !important;
    height: 36px !important;
    min-height: 36px !important;
    max-height: 36px !important;
    padding-block: 0 !important;
    border-block-end: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    position: relative !important;
  }

  .announcement-bar .section-background {
    background-color: #000000 !important;
  }

  .announcement-bar__slider {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    width: 100% !important;
    max-width: 450px !important;
    margin-inline: auto !important;
    height: 36px !important;
    box-sizing: border-box !important;
    padding-inline: 36px !important;
  }

  .announcement-bar__control {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 28px !important;
    height: 28px !important;
    min-width: 28px !important;
    min-height: 28px !important;
    padding: 0 !important;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    color: #ffffff !important;
    cursor: pointer !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    z-index: 5 !important;
    -webkit-tap-highlight-color: transparent !important;
    user-select: none !important;
    transition: none !important;
    animation: none !important;
  }

  .announcement-bar__control:hover,
  .announcement-bar__control:focus,
  .announcement-bar__control:focus-visible,
  .announcement-bar__control:active {
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    border: none !important;
    transform: translateY(-50%) !important;
    opacity: 1 !important;
    color: #ffffff !important;
    transition: none !important;
    animation: none !important;
    -webkit-tap-highlight-color: transparent !important;
  }

  .announcement-bar__control--previous {
    left: 0 !important;
  }

  .announcement-bar__control--next {
    right: 0 !important;
  }

  .announcement-bar__control svg {
    display: block !important;
    width: 7px !important;
    height: 10px !important;
    color: #ffffff !important;
    transition: none !important;
    animation: none !important;
    transform: none !important;
  }

  .announcement-bar__control svg path {
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 2 !important;
    transition: none !important;
    animation: none !important;
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__slider {
      max-width: 100% !important;
      padding-inline: 36px !important;
    }

    .announcement-bar__control--previous {
      left: 6px !important;
    }

    .announcement-bar__control--next {
      right: 6px !important;
    }
  }

  .announcement-bar__slides {
    position: relative !important;
    overflow: hidden !important;
    height: 36px !important;
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: auto !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .announcement-bar__slide {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    margin: 0 auto !important;
    content-visibility: visible !important;
    pointer-events: none !important;
    transform: translateY(100%) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: none !important;
  }

  /* Default initial visible slide & active slide */
  .announcement-bar__slide.is-active,
  .announcement-bar__slide[aria-hidden='false']:not(.is-exiting) {
    transform: translateY(0%) !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    z-index: 2 !important;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1) !important;
  }

  /* Animated exiting slide (chữ hiện tại chạy lên và mờ dần) */
  .announcement-bar__slide.is-exiting {
    transform: translateY(-100%) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    z-index: 1 !important;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1) !important;
  }

  .announcement-bar__text {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    line-height: 36px !important;
    letter-spacing: normal !important;
    color: #ffffff !important;
    margin: 0 !important;
    padding: 0 !important;
    text-align: center !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .announcement-bar__text:first-child {
    margin: 0 !important;
  }

  .announcement-bar__link {
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
