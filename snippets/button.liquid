{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

{% assign has_arrow_circle = false %}
{% assign label_downcase = block_settings.label | downcase | strip %}
{% if label_downcase contains 'view all' or label_downcase contains 'view_all' %}
  {% assign has_arrow_circle = true %}
{% endif %}

{% if has_arrow_circle %}
  {% style %}
    .button--view-all,
    a.button--view-all,
    a.button.button--view-all,
    a.button-secondary.button--view-all,
    a.button-custom.button--view-all,
    a.button-unstyled.button--view-all {
      --text-color: var(--color-foreground-rgb, 26 26 26);
      display: inline-flex !important;
      align-items: center !important;
      gap: 10px !important;
      font-size: 15px !important;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
      font-weight: 500 !important;
      color: #1a1a1a !important;
      background: transparent !important;
      background-color: transparent !important;
      border: none !important;
      border-bottom: none !important;
      box-shadow: none !important;
      outline: none !important;
      padding: 0 !important;
      padding-block: 0 !important;
      padding-inline: 0 !important;
      min-height: 24px !important;
      min-width: auto !important;
      height: 24px !important;
      width: fit-content !important;
      text-decoration: none !important;
      text-decoration-line: none !important;
      text-decoration-color: transparent !important;
      text-decoration-thickness: 0px !important;
      -webkit-text-decoration: none !important;
      line-height: 24px !important;
      cursor: pointer !important;
      overflow: visible !important;
      box-sizing: border-box !important;
      transition: color 0.2s ease !important;
      transform: translateZ(0) !important;
      -webkit-font-smoothing: antialiased !important;
    }

    .button--view-all:hover,
    .button--view-all:focus,
    .button--view-all:active,
    .button--view-all:visited,
    a.button--view-all:hover,
    a.button.button--view-all:hover,
    a.button-secondary.button--view-all:hover,
    a.button-custom.button--view-all:hover,
    a.button-unstyled.button--view-all:hover,
    a.button--view-all:focus,
    a.button--view-all:active,
    a.button--view-all:visited {
      background: transparent !important;
      background-color: transparent !important;
      border: none !important;
      border-bottom: none !important;
      box-shadow: none !important;
      color: #1a1a1a !important;
      outline: none !important;
      padding: 0 !important;
      margin: 0 !important;
      text-decoration: none !important;
      text-decoration-line: none !important;
      text-decoration-color: transparent !important;
      text-decoration-thickness: 0px !important;
      -webkit-text-decoration: none !important;
    }

    .button--view-all::after,
    a.button--view-all::after,
    .button--view-all:hover::after,
    a.button--view-all:hover::after,
    .button--view-all::before,
    a.button--view-all::before,
    .button--view-all:hover::before,
    a.button--view-all:hover::before {
      display: none !important;
      content: none !important;
    }

    .button--view-all .button__text {
      position: relative !important;
      display: inline-flex !important;
      align-items: center !important;
      height: 24px !important;
      line-height: 24px !important;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
      font-size: 15px !important;
      font-weight: 500 !important;
      color: #1a1a1a !important;
      -webkit-text-fill-color: #1a1a1a !important;
      opacity: 1 !important;
      visibility: visible !important;
      text-decoration: none !important;
      text-decoration-line: none !important;
      text-decoration-color: transparent !important;
      text-decoration-thickness: 0px !important;
      -webkit-text-decoration: none !important;
      box-sizing: border-box !important;
      vertical-align: middle !important;
      padding: 0 !important;
      margin: 0 !important;
      border: none !important;
      border-bottom: none !important;
    }

    .button--view-all:hover .button__text {
      color: #1a1a1a !important;
      -webkit-text-fill-color: #1a1a1a !important;
      text-decoration: none !important;
      text-decoration-line: none !important;
      text-decoration-color: transparent !important;
      text-decoration-thickness: 0px !important;
      border-bottom: none !important;
    }

    .button--view-all .button__text::after {
      content: '' !important;
      position: absolute !important;
      left: 0 !important;
      bottom: 0px !important;
      width: 100% !important;
      height: 1px !important;
      min-height: 1px !important;
      max-height: 1px !important;
      line-height: 0 !important;
      font-size: 0 !important;
      overflow: hidden !important;
      background-color: #1a1a1a !important;
      transform: scaleX(0) translateZ(0) !important;
      transform-origin: left bottom !important;
      transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
      will-change: transform !important;
      backface-visibility: hidden !important;
      -webkit-backface-visibility: hidden !important;
      pointer-events: none !important;
    }

    .button--view-all:hover .button__text::after,
    .button--view-all:focus-visible .button__text::after {
      transform: scaleX(1) translateZ(0) !important;
      transform-origin: left bottom !important;
    }

    .button--view-all .button__arrow-circle {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 24px !important;
      height: 24px !important;
      min-width: 24px !important;
      min-height: 24px !important;
      max-width: 24px !important;
      max-height: 24px !important;
      border-radius: 50% !important;
      background: rgb(var(--text-color) / .1) !important;
      color: #1a1a1a !important;
      flex-shrink: 0 !important;
      text-decoration: none !important;
      transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease !important;
    }

    .button--view-all .button__arrow-circle svg {
      display: block !important;
      width: 5px !important;
      height: 8px !important;
      color: currentColor !important;
      stroke: currentColor !important;
      transition: stroke 0.25s ease, color 0.25s ease !important;
    }

    .button--view-all .button__arrow-circle svg path {
      stroke: currentColor !important;
      transition: stroke 0.25s ease !important;
    }

    .button--view-all:hover .button__arrow-circle {
      background: #000000 !important;
      background-color: #000000 !important;
      color: #ffffff !important;
    }

    .button--view-all:hover .button__arrow-circle svg,
    .button--view-all:hover .button__arrow-circle svg path {
      color: #ffffff !important;
      stroke: #ffffff !important;
    }
  {% endstyle %}
{% endif %}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
    {% if has_arrow_circle %}button--view-all{% endif %}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  <span class="button__text">{{ block_settings.label }}</span>
  {%- if has_arrow_circle -%}
    <span class="button__arrow-circle" aria-hidden="true">
      <svg role="presentation" focusable="false" width="5" height="8" class="icon icon-chevron-right-small reverse-icon" viewBox="0 0 5 8">
        <path d="m.75 7 3-3-3-3" fill="none" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </span>
  {%- endif -%}
</a>
